#!/usr/bin/env bash
# mpx-switch — Switch to the Nth multiplex session (matches mpx TUI ordering)
# Used by tmux keybindings: bind 1 run-shell -b "mpx-switch 1"

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
SESSIONS_DIR="${SESSIONS_DIR:-$SCRIPT_DIR/sessions}"
TARGET="${1:-}"

if [[ -z "$TARGET" ]] || [[ "$TARGET" -lt 1 ]] || [[ "$TARGET" -gt 9 ]]; then
    exit 1
fi

STALE_REMOVE=600
now=$(date +%s)

# Build sorted list matching mpx's ordering
entries=()
for f in "$SESSIONS_DIR"/*.json; do
    [[ -f "$f" ]] || continue

    pid=$(jq -r '.pid // 0' "$f" 2>/dev/null) || continue
    tmux_pane=$(jq -r '.tmux_pane // empty' "$f" 2>/dev/null) || continue

    # tmux pane check — primary authority for visibility
    if [[ -n "$tmux_pane" ]]; then
        if ! tmux display-message -p -t "$tmux_pane" '#D' &>/dev/null; then
            continue
        fi
        # Verify pane belongs to expected tmux session (IDs reuse after server restart)
        expected_session=$(jq -r '.tmux_session // empty' "$f" 2>/dev/null) || expected_session=""
        if [[ -n "$expected_session" ]]; then
            actual_session=$(tmux display-message -p -t "$tmux_pane" '#{session_name}' 2>/dev/null) || actual_session=""
            if [[ -n "$actual_session" && "$actual_session" != "$expected_session" ]]; then
                continue
            fi
        fi
    fi

    # Staleness — only for sessions without pane info
    last_update=$(jq -r '.last_update // 0' "$f" 2>/dev/null) || continue
    age=$((now - last_update))
    if [[ -z "$tmux_pane" && "$age" -gt "$STALE_REMOVE" ]]; then
        continue
    fi

    # Sort by status priority, then creation time (matches mpx TUI)
    created_at=$(jq -r '.created_at // .last_update // 0' "$f" 2>/dev/null) || continue
    s_status=$(jq -r '.status // "active"' "$f" 2>/dev/null) || s_status="active"
    case "$s_status" in
        active|waiting) priority=0 ;;
        done)           priority=1 ;;
        *)              priority=2 ;;
    esac

    entries+=("${priority}${created_at}|${f}")
done

if [[ ${#entries[@]} -eq 0 ]]; then
    exit 0
fi

IFS=$'\n' sorted=($(printf '%s\n' "${entries[@]}" | sort -n)); unset IFS

idx=$((TARGET - 1))
if [[ "$idx" -ge "${#sorted[@]}" ]]; then
    exit 0
fi

file="${sorted[$idx]#*|}"

tmux_session=$(jq -r '.tmux_session // empty' "$file" 2>/dev/null)
tmux_window=$(jq -r '.tmux_window // empty' "$file" 2>/dev/null)
tmux_pane=$(jq -r '.tmux_pane // empty' "$file" 2>/dev/null)

if [[ -n "$tmux_session" ]]; then
    tmux switch-client -t "$tmux_session" 2>/dev/null || true
    if [[ -n "$tmux_window" ]]; then
        tmux select-window -t "${tmux_session}:${tmux_window}" 2>/dev/null || true
    fi
fi

if [[ -n "$tmux_pane" ]]; then
    tmux select-pane -t "$tmux_pane" 2>/dev/null || true
fi
