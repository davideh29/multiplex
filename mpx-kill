#!/usr/bin/env bash
# mpx-kill — Kill current tmpx session and switch to another active one
# Used by tmux keybinding: bind Q run-shell -b "mpx-kill"

set -uo pipefail

SESSIONS_DIR="$HOME/workplace/multiplex/sessions"
STALE_REMOVE=600

current_session=$(tmux display-message -p '#{session_name}' 2>/dev/null) || exit 1

now=$(date +%s)

# Build sorted list of active sessions (same ordering as mpx), skipping current
entries=()
for f in "$SESSIONS_DIR"/*.json; do
    [[ -f "$f" ]] || continue

    pid=$(jq -r '.pid // 0' "$f" 2>/dev/null) || continue
    tmux_pane=$(jq -r '.tmux_pane // empty' "$f" 2>/dev/null) || continue
    tmux_session=$(jq -r '.tmux_session // empty' "$f" 2>/dev/null) || continue

    # Skip the current session
    [[ "$tmux_session" == "$current_session" ]] && continue

    # PID check
    if [[ "$pid" -gt 0 ]] && ! kill -0 "$pid" 2>/dev/null; then
        continue
    fi

    # tmux pane check
    if [[ -n "$tmux_pane" ]] && ! tmux display-message -p -t "$tmux_pane" '#D' &>/dev/null; then
        continue
    fi

    # Staleness check
    last_update=$(jq -r '.last_update // 0' "$f" 2>/dev/null) || continue
    age=$((now - last_update))
    if [[ "$age" -gt "$STALE_REMOVE" ]]; then
        continue
    fi

    # Sort key matching mpx: waiting=0, done=1, active=2
    status=$(jq -r '.status // "active"' "$f" 2>/dev/null) || continue
    case "$status" in
        waiting) sort_key=0 ;;
        done)    sort_key=1 ;;
        active)  sort_key=2 ;;
        *)       sort_key=3 ;;
    esac

    entries+=("${sort_key}|${f}")
done

if [[ ${#entries[@]} -gt 0 ]]; then
    # Sort and pick the first (highest priority) session to switch to
    IFS=$'\n' sorted=($(printf '%s\n' "${entries[@]}" | sort)); unset IFS

    file="${sorted[0]#*|}"
    target_session=$(jq -r '.tmux_session // empty' "$file" 2>/dev/null)
    target_window=$(jq -r '.tmux_window // empty' "$file" 2>/dev/null)
    target_pane=$(jq -r '.tmux_pane // empty' "$file" 2>/dev/null)

    # Switch to the target session first, then kill the old one
    if [[ -n "$target_session" ]]; then
        tmux switch-client -t "$target_session" 2>/dev/null || true
        if [[ -n "$target_window" ]]; then
            tmux select-window -t "${target_session}:${target_window}" 2>/dev/null || true
        fi
    fi
    if [[ -n "$target_pane" ]]; then
        tmux select-pane -t "$target_pane" 2>/dev/null || true
    fi
fi

# Kill the original session
tmux kill-session -t "$current_session" 2>/dev/null || true
