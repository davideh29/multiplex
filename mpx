#!/usr/bin/env bash
# mpx — Multiplex interactive session monitor
# Displays all active Claude Code sessions and allows switching between them.
# Run in a tmux pane: tmux split-window -v -l 10 mpx

set -uo pipefail

SESSIONS_DIR="$HOME/workplace/multiplex/sessions"
mkdir -p "$SESSIONS_DIR"

STALE_REMOVE=600         # 10 minutes — auto-remove stale sessions
INACTIVE_TIMEOUT=60      # 60 seconds — auto-remove exited sessions even if pane alive

# ANSI colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
DIM='\033[2m'
BOLD='\033[1m'
RESET='\033[0m'
WHITE='\033[1;37m'
CYAN='\033[0;36m'

cleanup_session() {
    local file="$1"
    local sid
    sid=$(basename "$file" .json)
    rm -f "$file"
    rm -f "$SCRIPT_DIR/.summary-cache/${sid}.size"
}

check_session_alive() {
    local file="$1"
    local pid tmux_pane status

    pid=$(jq -r '.pid // 0' "$file" 2>/dev/null) || return 1
    tmux_pane=$(jq -r '.tmux_pane // empty' "$file" 2>/dev/null) || return 1
    status=$(jq -r '.status // "active"' "$file" 2>/dev/null) || return 1

    # tmux pane is the PRIMARY authority for visibility
    if [[ -n "$tmux_pane" ]]; then
        if tmux display-message -p -t "$tmux_pane" '#D' &>/dev/null; then
            # Verify pane belongs to the expected tmux session
            # (pane IDs can be reused after tmux server restart)
            local expected_session
            expected_session=$(jq -r '.tmux_session // empty' "$file" 2>/dev/null)
            if [[ -n "$expected_session" ]]; then
                local actual_session
                actual_session=$(tmux display-message -p -t "$tmux_pane" '#{session_name}' 2>/dev/null) || actual_session=""
                if [[ -n "$actual_session" && "$actual_session" != "$expected_session" ]]; then
                    cleanup_session "$file"
                    return 1
                fi
            fi
            # Pane alive — but inactive sessions should auto-expire
            if [[ "$status" == "inactive" ]]; then
                local last_update now age
                last_update=$(jq -r '.last_update // 0' "$file" 2>/dev/null) || last_update=0
                now=$(date +%s)
                age=$((now - last_update))
                if [[ "$age" -gt "$INACTIVE_TIMEOUT" ]]; then
                    cleanup_session "$file"
                    return 1
                fi
                return 0  # still within timeout, show briefly
            fi
            # If Claude PID is dead, one-shot update status to inactive
            if [[ "$pid" -gt 0 ]] && ! kill -0 "$pid" 2>/dev/null; then
                if [[ "$status" != "inactive" ]]; then
                    local now
                    now=$(date +%s)
                    jq '.status = "inactive" | .activity = "Exited" | .pid = 0' \
                        "$file" > "${file}.tmp" && mv "${file}.tmp" "$file" 2>/dev/null || true
                fi
            fi
            return 0
        fi

        # Pane is dead — only delete if also stale
        local last_update now age
        last_update=$(jq -r '.last_update // 0' "$file" 2>/dev/null) || last_update=0
        now=$(date +%s)
        age=$((now - last_update))
        if [[ "$age" -gt "$STALE_REMOVE" ]]; then
            cleanup_session "$file"
        fi
        return 1
    fi

    # No pane info — can't switch to this session, don't display.
    # Clean up the file if no live process.
    if [[ "$pid" -le 0 ]] || ! kill -0 "$pid" 2>/dev/null; then
        local last_update now age
        last_update=$(jq -r '.last_update // 0' "$file" 2>/dev/null) || last_update=0
        now=$(date +%s)
        age=$((now - last_update))
        if [[ "$age" -gt "$INACTIVE_TIMEOUT" ]]; then
            cleanup_session "$file"
        fi
    fi
    return 1
}

format_age() {
    local seconds="$1"
    if [[ "$seconds" -lt 60 ]]; then
        echo "${seconds}s ago"
    elif [[ "$seconds" -lt 3600 ]]; then
        echo "$((seconds / 60))m ago"
    else
        echo "$((seconds / 3600))h ago"
    fi
}

render() {
    # Move cursor to top-left instead of clearing — eliminates flicker
    printf '\033[H'

    local now lines=0
    now=$(date +%s)

    # Collect and validate sessions
    local -a session_files_raw=()
    for f in "$SESSIONS_DIR"/*.json; do
        [[ -f "$f" ]] || continue
        if check_session_alive "$f"; then
            session_files_raw+=("$f")
        fi
    done

    # Deduplicate by tmux_pane — keep newest per pane, remove ghosts
    declare -A pane_best_file pane_best_ts
    for f in "${session_files_raw[@]}"; do
        local pane ts
        pane=$(jq -r '.tmux_pane // empty' "$f" 2>/dev/null) || continue
        ts=$(jq -r '.last_update // 0' "$f" 2>/dev/null) || continue
        if [[ -z "$pane" ]]; then
            # No pane info — keep it
            pane="__nopane_${f}"
        fi
        if [[ -z "${pane_best_ts[$pane]:-}" || "$ts" -gt "${pane_best_ts[$pane]}" ]]; then
            # Clean up the previous best if it's being replaced
            if [[ -n "${pane_best_file[$pane]:-}" && "${pane_best_file[$pane]}" != "$f" ]]; then
                rm -f "${pane_best_file[$pane]}"
            fi
            pane_best_file[$pane]="$f"
            pane_best_ts[$pane]="$ts"
        else
            # This file is the older duplicate — remove it
            rm -f "$f"
        fi
    done
    local -a session_files=()
    for f in "${pane_best_file[@]}"; do
        session_files+=("$f")
    done

    # Header
    printf '\033[2K'; echo -e "${BOLD}${WHITE} MULTIPLEX${RESET}"; ((lines++))
    printf '\033[2K'; echo -e "${DIM} ─────────────────────────────────────────────────────────────────────────${RESET}"; ((lines++))

    if [[ ${#session_files[@]} -eq 0 ]]; then
        printf '\033[2K'; echo ""; ((lines++))
        printf '\033[2K'; echo -e "${DIM}  No active sessions${RESET}"; ((lines++))
        printf '\033[2K'; echo ""; ((lines++))
        printf '\033[2K'; echo -e "${DIM} ─────────────────────────────────────────────────────────────────────────${RESET}"; ((lines++))
        printf '\033[2K'; echo -e "${DIM}  n new workspace │ q quit${RESET}"; ((lines++))
        # Erase any leftover lines from previous render
        printf '\033[J'
        LAST_LINES=$lines
        return
    fi

    # Build sortable entries by status priority, then creation time
    # Active/waiting get low numbers; done/inactive get pushed down
    local -a sort_entries=()
    for f in "${session_files[@]}"; do
        local created_at s_status priority
        created_at=$(jq -r '.created_at // .last_update // 0' "$f" 2>/dev/null) || continue
        s_status=$(jq -r '.status // "active"' "$f" 2>/dev/null) || s_status="active"
        case "$s_status" in
            active|waiting) priority=0 ;;
            done)           priority=1 ;;
            *)              priority=2 ;;
        esac
        sort_entries+=("${priority}${created_at}|${f}")
    done

    # Sort entries (numeric — priority first, then oldest within each group)
    IFS=$'\n' sorted=($(printf '%s\n' "${sort_entries[@]}" | sort -n)); unset IFS

    # Detect current tmux session for highlighting
    local current_tmux_session
    current_tmux_session=$(tmux display-message -p '#{session_name}' 2>/dev/null) || current_tmux_session=""

    # Table header
    printf '\033[2K'
    printf "  ${DIM}%-3s %-20s %-10s %-8s %-10s %s${RESET}\n" "#" "PROJECT" "STATUS" "CTX %" "UPDATED" "ACTIVITY"
    ((lines++))

    # Store ordered file paths for keypress lookup
    ORDERED_FILES=()

    local idx=1
    for entry in "${sorted[@]}"; do
        local file="${entry#*|}"
        ORDERED_FILES+=("$file")

        local project status ctx_pct last_update activity tmux_sess summary subagent_count
        project=$(jq -r '.project // "?"' "$file" 2>/dev/null)
        status=$(jq -r '.status // "?"' "$file" 2>/dev/null)
        ctx_pct=$(jq -r '.context_pct // 0' "$file" 2>/dev/null)
        last_update=$(jq -r '.last_update // 0' "$file" 2>/dev/null)
        activity=$(jq -r '.activity // ""' "$file" 2>/dev/null)
        tmux_sess=$(jq -r '.tmux_session // empty' "$file" 2>/dev/null)
        summary=$(jq -r '.summary // ""' "$file" 2>/dev/null)
        subagent_count=$(jq '(.subagents // {}) | length' "$file" 2>/dev/null) || subagent_count=0

        local age=$((now - last_update))
        local age_str
        age_str=$(format_age "$age")

        # Truncate project name
        if [[ ${#project} -gt 20 ]]; then
            project="${project:0:19}…"
        fi

        # Truncate activity
        if [[ ${#activity} -gt 25 ]]; then
            activity="${activity:0:24}…"
        fi

        # Color and indicator based on status
        local color indicator status_text
        case "$status" in
            waiting)
                color="$RED"
                indicator="●"
                status_text="waiting"
                ;;
            active)
                color="$GREEN"
                indicator="●"
                status_text="active"
                ;;
            done)
                color="$BLUE"
                indicator="●"
                status_text="done"
                ;;
            inactive)
                color="$DIM"
                indicator="○"
                status_text="inactive"
                ;;
            *)
                color="$DIM"
                indicator="?"
                status_text="$status"
                ;;
        esac

        # Highlight current session
        local is_current=false
        if [[ -n "$current_tmux_session" && "$tmux_sess" == "$current_tmux_session" ]]; then
            is_current=true
        fi

        local ctx_int="${ctx_pct%.*}"
        printf '\033[2K'
        if [[ "$is_current" == true ]]; then
            printf "${BOLD} >%-3s %-20s ${color}${indicator} %-8s${RESET}${BOLD} %-8s %-10s ${DIM}%s${RESET}\n" \
                "$idx" "$project" "$status_text" "${ctx_int}%" "$age_str" "$activity"
        else
            printf "  %-3s %-20s ${color}${indicator} %-8s${RESET} %-8s %-10s ${DIM}%s${RESET}\n" \
                "$idx" "$project" "$status_text" "${ctx_int}%" "$age_str" "$activity"
        fi
        ((lines++))

        # Summary sub-row (dimmed, indented)
        if [[ -n "$summary" ]]; then
            # Truncate to 70 chars
            if [[ ${#summary} -gt 70 ]]; then
                summary="${summary:0:69}…"
            fi
            printf '\033[2K'
            printf "      ${DIM}%s${RESET}\n" "$summary"
            ((lines++))
        fi

        # Subagent info sub-row
        if [[ "$subagent_count" -gt 0 ]]; then
            local agent_label="agent"
            [[ "$subagent_count" -gt 1 ]] && agent_label="agents"
            printf '\033[2K'
            printf "      ${DIM}↳ %d %s running${RESET}\n" "$subagent_count" "$agent_label"
            ((lines++))
        fi

        idx=$((idx + 1))
    done

    printf '\033[2K'; echo -e "${DIM} ─────────────────────────────────────────────────────────────────────────${RESET}"; ((lines++))
    printf '\033[2K'; echo -e "${DIM}  1-9 switch │ n new workspace │ q quit${RESET}"; ((lines++))

    # Erase any leftover lines below (e.g. if session count decreased)
    printf '\033[J'
    LAST_LINES=$lines
}

switch_to_session() {
    local file="$1"

    local tmux_pane tmux_session tmux_window
    tmux_pane=$(jq -r '.tmux_pane // empty' "$file" 2>/dev/null)
    tmux_session=$(jq -r '.tmux_session // empty' "$file" 2>/dev/null)
    tmux_window=$(jq -r '.tmux_window // empty' "$file" 2>/dev/null)

    if [[ -z "$tmux_pane" ]]; then
        return 1
    fi

    if [[ -n "$tmux_session" ]]; then
        tmux switch-client -t "$tmux_session" 2>/dev/null || true
        if [[ -n "$tmux_window" ]]; then
            tmux select-window -t "${tmux_session}:${tmux_window}" 2>/dev/null || true
        fi
    fi
    tmux select-pane -t "$tmux_pane" 2>/dev/null || true
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Hide cursor, restore on exit
tput civis 2>/dev/null || true
trap 'tput cnorm 2>/dev/null || true; exit 0' EXIT INT TERM

clear
ORDERED_FILES=()
LAST_LINES=0

while true; do
    render

    # read -t 1 doubles as refresh interval
    if read -rsn1 -t 1 key 2>/dev/null; then
        case "$key" in
            q|Q)
                exit 0
                ;;
            [1-9])
                local_idx=$((key - 1))
                if [[ "$local_idx" -lt "${#ORDERED_FILES[@]}" ]]; then
                    switch_to_session "${ORDERED_FILES[$local_idx]}"
                fi
                ;;
            n|N)
                "$SCRIPT_DIR/tmpx" &
                ;;
        esac
    fi
done
